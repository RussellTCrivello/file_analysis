#: C:/Users/Zoro/Pictures/file_analysis_data/templates/Word/Word_list.html:29
msgid ""
"Words represent individual terms extracted from file content during "
"analysis"
msgstr "تمثل الكلمات مصطلحات فردية مستخرجة من محتوى الملف أثناء التحليل"

#: C:/Users/Zoro/Pictures/file_analysis_data/templates/Word/Word_list.html:30
msgid ""
"The system tracks word frequency, usage across files, and associations "
"with categories"
msgstr "يتتبع النظام تكرار الكلمات والاستخدام عبر الملفات والارتباطات مع الفئات"

#: C:/Users/Zoro/Pictures/file_analysis_data/templates/Word/Word_list.html:31
msgid ""
"Words help identify common themes, patterns, and important terminology in"
" your documents"
msgstr ""
"تساعد الكلمات في تحديد الموضوعات والأنماط والمصطلحات المهمة الشائعة في "
