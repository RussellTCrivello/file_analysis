# Example environment configuration for development.
# Copy to .env and adjust. NEVER commit a real .env with production secrets.
# In production, provide secrets via a secret manager / OS keychain instead.

# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=development
FLASK_DEBUG=false

# Database Configuration (SEC-07: credentials are never hardcoded)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analysis
DB_USER=postgres
DB_PASSWORD=

# Ingestion security (SEC-06): server paths that ingestion may access.
# Semicolon-separated list of absolute directories. Empty disables server-path
# ingestion (uploads still work). Native Windows paths are supported:
#   Windows:  INGESTION_ROOTS=C:\data\evidence;D:\inbox   (UNC: \\server\share\cases)
#   POSIX:    INGESTION_ROOTS=/data/evidence;/srv/inbox
INGESTION_ROOTS=

# Initial admin (first-run bootstrap; if unset a random password is generated
# and written to the runtime directory with 0600 permissions)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Connection Pool
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=25

# File Processing
FILE_CHUNK_SIZE=10485760
MAX_WORKERS=8
MAX_FILE_SIZE=0

# Logging
LOG_LEVEL=INFO
