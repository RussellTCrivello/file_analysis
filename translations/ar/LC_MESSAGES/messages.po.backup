msgstr "انقر على \"إضافة كلمة\" لإضافة كلمة يدوياً إلى النظام"

#: C:/Users/Zoro/Pictures/file_analysis_data/templates/Word/Word_list.html:42
msgid ""
"Words are typically added automatically during file analysis, but can be "
"manually created"
