{
  "system": {
    "app_name": "File Analysis System",
    "app_icon": "bi-file-earmark-text",
    "app_logo": "",
    "language": "en",
    "timezone": "UTC",
    "date_format": "YYYY-MM-DD",
    "time_format": "24h",
    "theme": "light",
    "animations_enabled": true,
    "notifications_enabled": true,
    "show_breadcrumbs": true,
    "compact_mode": false,
    "auto_save": true,
    "confirm_actions": true,
    "items_per_page": 50,
    "default_sort": "date_creation",
    "sort_direction": "desc",
    "debug_mode": false,
    "log_level": "INFO",
    "log_file": null,
    "action_logging_enabled": true
  },
  "display": {
    "compact_view": false,
    "show_file_preview": true,
    "show_metadata": true,
    "results_per_page": 50,
    "default_sort": "date_creation",
    "sort_direction": "desc",
    "theme": "light",
    "language": "en"
  },
  "search": {
    "default_search_type": "basic",
    "case_sensitive": false,
    "highlight_results": true,
    "search_in_content": true,
    "search_in_filename": true,
    "search_in_metadata": false,
    "max_results": 1000,
    "enable_history": true,
    "enable_saved_searches": true
  },
  "processing": {
    "use_threading": true,
    "max_workers": 8,
    "enable_monitoring": true,
    "monitor_interval": 5.0,
    "use_priority": true,
    "chunk_size": 1048576,
    "parallel_processing": true,
    "auto_process_uploads": true,
    "extract_archives": true,
    "extract_attachments": true,
    "process_nested": true,
    "calculate_hashes": true,
    "extract_text": true,
    "extract_metadata": true,
    "max_depth": 10,
    "file_processing_timeout": 1200
  },
  "notifications": {
    "enabled": true,
    "email_notifications": false,
    "browser_notifications": true,
    "processing_complete": true,
    "batch_complete": true,
    "errors_only": false,
    "similar_files_enabled": true,
    "future_dates_enabled": true,
    "future_events_enabled": true,
    "auto_analyze_files": true,
    "upcoming_events_days": 30
  },
  "theme": {
    "primary_color": "#4f46e5",
